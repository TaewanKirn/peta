<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos Vehicle SDK: 기어(Gear), 주행 시간(Odometer) / 도어(Door) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- Pleos Vehicle SDK: EvBattery(배터리 잔량, C07 충전 안내) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- C07 [휴식 시작] 펫 케어 공조 (HVAC 전원 · 오토 · 온도). 둘 다 normal 등급 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <!-- Pleos NaviHelper SDK: 조회(get*Info) / 경로·경유지 요청 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 차량 속도 (AAOS PERF_VEHICLE_SPEED) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Pleos TextToSpeech SDK: 주행 중 음성 안내(C05) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- SDK 점검용(SdkProbe): SpeechToText / FusedLocation -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- C05 음성 응답("응"/"아니") -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 모바일에서 저장한 여행 조회 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 차량 음성 엔진(Pleos TTS, Gleo 음성 인식)에 접근하기 위한 패키지 가시성 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Peta">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- 주행 중 화면: 정적·터치 최소 (CarUxRestrictions 준수). Pleos 출시 시 DO 심사 필요 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PetaService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tracks driving and parking state during a trip with a pet" />
        </service>
    </application>
</manifest>
